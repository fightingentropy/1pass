# Vercel Blob configuration
# Required when deploying to Vercel. Generate the token from the "Storage" section
# of your project dashboard after enabling Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Optional overrides for where the encrypted vault is stored in Blob.
# Defaults shown here match the production configuration in code.
VAULT_BLOB_PREFIX="vaults"
VAULT_BLOB_KEY="vault.json"
